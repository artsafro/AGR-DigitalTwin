{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git worktree list:*)",
      "Bash(git remote -v)",
      "Bash(git ls-files:*)",
      "Bash(git lfs ls-files:*)",
      "Bash(git lfs status:*)",
      "Bash(git check-attr:*)",
      "Bash(git check-ignore:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run dt:*)",
      "Bash(uv run python tools/:*)",
      "Bash(python tools/:*)",
      "Bash(py -3 tools/:*)",
      "Bash(py -3 .claude/hooks/:*)",
      "WebSearch",
      "WebFetch(domain:dev.epicgames.com)",
      "WebFetch(domain:docs.blender.org)",
      "WebFetch(domain:help.autodesk.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:code.claude.com)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
