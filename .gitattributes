# Line endings: normalize text to LF in the repo; Windows scripts keep CRLF.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ms  text eol=crlf
*.mcr text eol=crlf

# Large production binaries go to Git LFS (approved 2026-10-06). The account LFS budget is
# exhausted (2026-10-06): the regulation PDF is a plain blob; see docs/backlog.md H9.
# Heavy sources may still live outside the repo, referenced by path.
*.pdf   binary
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg   binary
*.jpeg  binary
*.tga    filter=lfs diff=lfs merge=lfs -text
*.tif    filter=lfs diff=lfs merge=lfs -text
*.tiff   filter=lfs diff=lfs merge=lfs -text
*.exr    filter=lfs diff=lfs merge=lfs -text
*.hdr   binary
*.psd    filter=lfs diff=lfs merge=lfs -text
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.obj   binary
*.abc   binary
*.glb   binary
*.blend  filter=lfs diff=lfs merge=lfs -text
*.max    filter=lfs diff=lfs merge=lfs -text
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
*.rvt    filter=lfs diff=lfs merge=lfs -text
*.skp    filter=lfs diff=lfs merge=lfs -text
*.dwg    filter=lfs diff=lfs merge=lfs -text
