{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Date",
          "type": "string"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "enum": [
            "synthetic_fixture",
            "project"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "date",
        "scope",
        "note"
      ],
      "title": "Approval",
      "type": "object"
    },
    "MasterBuilding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "surfaces": {
          "items": {
            "$ref": "#/$defs/Surface"
          },
          "minItems": 1,
          "title": "Surfaces",
          "type": "array"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "synthetic",
        "source",
        "surfaces"
      ],
      "title": "MasterBuilding",
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Approval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "diffuse_rgb": {
          "items": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Diffuse Rgb",
          "type": "array"
        },
        "emissive": {
          "maximum": 255,
          "minimum": 0,
          "title": "Emissive",
          "type": "integer"
        },
        "id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "metallic": {
          "maximum": 255,
          "minimum": 0,
          "title": "Metallic",
          "type": "integer"
        },
        "normal_opengl_rgb": {
          "items": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Normal Opengl Rgb",
          "type": "array"
        },
        "pattern_delta": {
          "default": 12,
          "maximum": 255,
          "minimum": 0,
          "title": "Pattern Delta",
          "type": "integer"
        },
        "roughness": {
          "maximum": 255,
          "minimum": 0,
          "title": "Roughness",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "status": {
          "enum": [
            "proposed",
            "approved",
            "conflict"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "status",
        "source",
        "diffuse_rgb",
        "emissive",
        "roughness",
        "metallic",
        "normal_opengl_rgb"
      ],
      "title": "Material",
      "type": "object"
    },
    "MaterialRegistry": {
      "additionalProperties": false,
      "properties": {
        "materials": {
          "items": {
            "$ref": "#/$defs/Material"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Materials",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "materials"
      ],
      "title": "MaterialRegistry",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Approval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "coordinate_system": {
          "enum": [
            "SYNTHETIC_LOCAL",
            "MSK-77"
          ],
          "title": "Coordinate System",
          "type": "string"
        },
        "insertion_xy": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Insertion Xy"
        },
        "project_zero_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Zero M"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "status": {
          "enum": [
            "unknown",
            "proposed",
            "approved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "coordinate_system",
        "source",
        "status"
      ],
      "title": "Placement",
      "type": "object"
    },
    "ProjectManifest": {
      "additionalProperties": false,
      "properties": {
        "address_token": {
          "maxLength": 120,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Address Token",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "minProperties": 1,
          "title": "Inputs",
          "type": "object"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "profile_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "NPM",
              "VPM"
            ]
          },
          "title": "Profile Versions",
          "type": "object"
        },
        "project_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "standards_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Standards Sha256",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "project_id",
        "synthetic",
        "address_token",
        "standards_sha256",
        "profile_versions",
        "inputs",
        "placement"
      ],
      "title": "ProjectManifest",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "synthetic",
            "pdf",
            "model",
            "user"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Surface": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "material_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Material Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "vertices": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Vertices",
          "type": "array"
        }
      },
      "required": [
        "id",
        "material_id",
        "vertices"
      ],
      "title": "Surface",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "master": {
      "$ref": "#/$defs/MasterBuilding"
    },
    "project": {
      "$ref": "#/$defs/ProjectManifest"
    },
    "registry": {
      "$ref": "#/$defs/MaterialRegistry"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "project",
    "registry",
    "master"
  ],
  "title": "BuildJob",
  "type": "object"
}
