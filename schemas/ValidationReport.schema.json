{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "observed": {
          "title": "Observed",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_pdf_pages": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Source Pdf Pages",
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "review",
            "not_applicable",
            "not_run"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "source_pdf_pages",
        "observed",
        "expected",
        "evidence"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Checks",
      "type": "array"
    },
    "development_checks_passed": {
      "title": "Development Checks Passed",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "passed": {
      "const": false,
      "default": false,
      "title": "Passed",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "synthetic",
    "source_sha256",
    "checks",
    "development_checks_passed",
    "limitations"
  ],
  "title": "ValidationReport",
  "type": "object"
}
